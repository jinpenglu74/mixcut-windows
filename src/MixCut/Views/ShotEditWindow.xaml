<Window x:Class="MixCut.Views.ShotEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        mc:Ignorable="d"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        Title="分镜头替换" Height="720" Width="980" MinHeight="600" MinWidth="780"
        WindowStartupLocation="CenterOwner" Background="White"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">
    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- [A] 顶栏 -->
        <Grid Grid.Row="0" Margin="16,12">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="分镜头替换" FontSize="17" FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}" />
                <TextBlock x:Name="CaptionText" FontSize="12" TextTrimming="CharacterEllipsis"
                           Foreground="{StaticResource TextTertiaryBrush}" Margin="0,2,0,0" MaxWidth="600"
                           HorizontalAlignment="Left" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button x:Name="ComposeButton" Content="合成新分镜" Click="OnComposeClick"
                        Background="{StaticResource AccentBlueBrush}" Foreground="White" BorderThickness="0"
                        Cursor="Hand" Padding="14,7" FontSize="13" FontWeight="SemiBold" Margin="0,0,8,0"
                        ToolTipService.ShowOnDisabled="True" />
                <Button x:Name="CloseBtn" Content="关闭" Click="OnCloseClick" ToolTip="关闭工作区（快捷键 Esc）"
                        Background="Transparent" Foreground="{StaticResource TextSecondaryBrush}"
                        BorderBrush="{StaticResource BorderPrimaryBrush}" BorderThickness="1"
                        Cursor="Hand" Padding="12,7" FontSize="13" />
            </StackPanel>
        </Grid>
        <Border Grid.Row="0" Height="1" VerticalAlignment="Bottom"
                Background="{StaticResource BorderSubtleBrush}" />

        <!-- [B] 分镜头轨道 -->
        <ScrollViewer x:Name="TrackScroll" Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                      Padding="16,12" MaxHeight="240" PreviewMouseWheel="OnTrackWheel">
            <StackPanel x:Name="TrackPanel" Orientation="Horizontal" />
        </ScrollViewer>

        <!-- 选中镜头编辑行 -->
        <StackPanel x:Name="EditRowPanel" Grid.Row="2" Orientation="Horizontal" Margin="16,0,16,10" />

        <Border Grid.Row="3" Height="1" Background="{StaticResource BorderSubtleBrush}" />

        <!-- [C] 版本区 -->
        <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto" Padding="16">
            <StackPanel x:Name="VersionPanel" />
        </ScrollViewer>

        <!-- [D] 错误横幅 -->
        <!-- 错误横幅：原来只有一个 ⚠ 加一行字，既没有重试也没有关闭 —— 用户读完只能干瞪眼。
             现在右侧带「重试」（有可重试动作时才出现）与「✕」。 -->
        <Border x:Name="ErrorBanner" Grid.Row="5" Background="#14C06F00" Padding="12,10" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="⚠" FontSize="14" Foreground="#C06F00" Margin="0,0,8,0" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" x:Name="ErrorText" FontSize="12" Foreground="#C06F00"
                           TextWrapping="Wrap" VerticalAlignment="Center" />
                <Button Grid.Column="2" x:Name="ErrorRetryButton" Content="重试"
                        Margin="12,0,0,0" Padding="10,3" FontSize="11" Cursor="Hand"
                        Background="White" BorderBrush="#C06F00" Foreground="#C06F00"
                        Visibility="Collapsed" Click="OnErrorRetryClick" />
                <Button Grid.Column="3" x:Name="ErrorCloseButton" Content="✕"
                        Margin="8,0,0,0" Padding="0" Width="22" Height="22" FontSize="11" Cursor="Hand"
                        Background="Transparent" BorderThickness="0" Foreground="#C06F00"
                        ToolTip="关闭提示" Click="OnErrorCloseClick" />
            </Grid>
        </Border>
    </Grid>
</Window>
