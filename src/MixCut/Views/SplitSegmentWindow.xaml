<Window x:Class="MixCut.Views.SplitSegmentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="拆分分镜" Width="440" Height="680"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource BgPrimaryBrush}"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="拖动手柄选择拆分点，画面实时预览到该帧"
                   FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                   Margin="0,0,0,12" />

        <!-- 9:16 画面预览 -->
        <Border Grid.Row="1" Background="Black" CornerRadius="8" ClipToBounds="True"
                HorizontalAlignment="Center" MaxWidth="320">
            <Image x:Name="PreviewImage" Stretch="Uniform" />
        </Border>

        <!-- 拆分点信息 -->
        <TextBlock Grid.Row="2" x:Name="InfoText" TextAlignment="Center"
                   FontSize="13" FontWeight="SemiBold"
                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,14,0,6" />

        <!-- 时间轴手柄 -->
        <Slider Grid.Row="3" x:Name="FrameSlider" Margin="0,0,0,16"
                IsSnapToTickEnabled="True" TickFrequency="1" />

        <!-- 按钮 -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="CancelButton" Content="取消" Width="90" Height="34"
                    Margin="0,0,10,0" Cursor="Hand"
                    Background="White" Foreground="{StaticResource TextPrimaryBrush}"
                    BorderBrush="{StaticResource BorderHoverBrush}" BorderThickness="1"
                    Click="OnCancel" />
            <Button x:Name="ConfirmButton" Content="确定拆分" Width="120" Height="34"
                    Cursor="Hand" Background="{StaticResource AccentBlueBrush}"
                    Foreground="White" BorderThickness="0" FontWeight="SemiBold"
                    Click="OnConfirm" />
        </StackPanel>
    </Grid>
</Window>
