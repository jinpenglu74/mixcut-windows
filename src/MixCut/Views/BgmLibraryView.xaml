<UserControl x:Class="MixCut.Views.BgmLibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#FFFFFF">
    <Grid Margin="28,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 标题栏 + 上传 -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="BGM 库" FontSize="20" FontWeight="Bold" Foreground="#222" />
                <TextBlock Text="全局共享的背景音乐库：所有项目可用。上传后可在「导出」页选一条替换成片背景音乐。"
                           FontSize="11" Foreground="#888" Margin="0,4,0,0" />
            </StackPanel>
            <Button x:Name="UploadButton" Content="⬆ 上传音乐" Click="OnUploadClick"
                    HorizontalAlignment="Right" VerticalAlignment="Top"
                    Padding="14,7" FontSize="12" Cursor="Hand"
                    Background="#1D6BE5" Foreground="White" BorderThickness="0" />
        </Grid>

        <!-- 列表 / 空态 -->
        <Grid Grid.Row="1">
            <!-- 空态引导 -->
            <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center"
                        Visibility="Collapsed">
                <TextBlock Text="🎵" FontSize="42" HorizontalAlignment="Center" Opacity="0.35" />
                <TextBlock Text="库里还没有音乐" FontSize="14" FontWeight="SemiBold"
                           Foreground="#666" HorizontalAlignment="Center" Margin="0,10,0,4" />
                <TextBlock Text="点击右上角「上传音乐」，支持 MP3 / M4A / WAV 等常见格式，可多选。"
                           FontSize="11" Foreground="#999" HorizontalAlignment="Center" />
            </StackPanel>

            <ScrollViewer x:Name="ListScroll" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="ListPanel" />
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
