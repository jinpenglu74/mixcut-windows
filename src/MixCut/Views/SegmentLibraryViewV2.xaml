<UserControl x:Class="MixCut.Views.SegmentLibraryViewV2"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:cards="clr-namespace:MixCut.ViewModels.Cards"
             xmlns:comp="clr-namespace:MixCut.Views.Components"
             xmlns:v="clr-namespace:MixCut.Views"
             xmlns:sl="clr-namespace:MixCut.Views.SegmentLibrary"
             xmlns:vm="clr-namespace:MixCut.ViewModels"
             xmlns:vwp="clr-namespace:WpfToolkit.Controls;assembly=VirtualizingWrapPanel"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d"
             Background="{StaticResource BgPrimaryBrush}">
    <UserControl.Resources>
        <!-- 对齐 mac：卡片改横向双栏（左缩略图+控件 | 右台词），故变宽变矮。 -->
        <sys:Double x:Key="SegmentCardWidth">474</sys:Double>
        <sys:Double x:Key="SegmentCardHeight">660</sys:Double>
        <!-- 卡片内满宽 9:16，避免视频缩在大面积空白中。 -->
        <sys:Double x:Key="SegmentCardThumbWidth">210</sys:Double>
        <sys:Double x:Key="SegmentCardThumbHeight">373</sys:Double>

        <Style x:Key="FrameStepButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource AccentBlueBrush}" />
            <Setter Property="Background" Value="{StaticResource AccentBlueLightBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background"
                                        Value="{StaticResource AccentBlueHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background"
                                        Value="{StaticResource AccentBlueAlpha20Brush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <DockPanel x:Name="RootDock" Margin="20,16,16,16">

        <!-- ========== 顶部工具栏 ========== -->
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="{StaticResource BgQuaternaryBrush}"
                        CornerRadius="{StaticResource CornerRadiusMd}" Padding="8,4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="🔍" FontSize="12"
                                   Foreground="{StaticResource TextQuaternaryBrush}"
                                   VerticalAlignment="Center" Margin="2,0,6,0" />
                        <TextBox Grid.Column="1" x:Name="SearchBox"
                                 BorderThickness="0" Background="Transparent"
                                 VerticalAlignment="Center" FontSize="12"
                                 TextChanged="OnSearchChanged" />
                        <Button Grid.Column="2" x:Name="ClearSearchButton" Content="✕"
                                Background="Transparent" BorderThickness="0"
                                Foreground="{StaticResource TextQuaternaryBrush}"
                                Padding="4,0" Cursor="Hand" Visibility="Collapsed"
                                Click="OnClearSearch" />
                    </Grid>
                </Border>

                <ComboBox Grid.Column="1" x:Name="ViewModeCombo" Width="86" Margin="8,0,0,0"
                          Padding="6,4" SelectionChanged="OnViewModeChanged">
                    <ComboBoxItem Content="网格" IsSelected="True" />
                    <ComboBoxItem Content="列表" />
                </ComboBox>

                <ComboBox Grid.Column="2" x:Name="SortCombo" Width="96" Margin="8,0,0,0"
                          Padding="6,4" SelectionChanged="OnSortChanged">
                    <ComboBoxItem Content="按时间" IsSelected="True" />
                    <ComboBoxItem Content="按质量" />
                </ComboBox>
            </Grid>

            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                          Margin="0,0,0,6">
                <ItemsControl x:Name="TypeChipList">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </ScrollViewer>

            <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" x:Name="StatsText" FontSize="11"
                           Foreground="{StaticResource TextTertiaryBrush}"
                           VerticalAlignment="Center" />
                <Button Grid.Column="1" x:Name="ResetButton" Content="✕  重置筛选"
                        Background="{StaticResource BgTertiaryBrush}"
                        Foreground="{StaticResource TextTertiaryBrush}"
                        BorderThickness="0" Padding="8,3" Margin="0,0,8,0"
                        FontSize="11" Cursor="Hand"
                        Click="OnResetFilter" Visibility="Collapsed" />
                <Button Grid.Column="2" x:Name="SelectionModeButton" Content="☑ 多选"
                        Background="White"
                        BorderBrush="{StaticResource BorderHoverBrush}"
                        BorderThickness="1" Padding="10,3"
                        FontSize="11" Cursor="Hand"
                        Click="OnToggleSelectionMode" />
            </Grid>

            <Border x:Name="SelectionToolbar" Background="{StaticResource AccentBlueLightBrush}"
                    CornerRadius="6" Padding="10,6" Margin="0,8,0,0" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" x:Name="SelectionCountText" Text="已选 0"
                               FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource AccentBlueBrush}"
                               VerticalAlignment="Center" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button Content="全选" Click="OnSelectAll"
                                Background="White" BorderBrush="{StaticResource BorderHoverBrush}"
                                BorderThickness="1" Padding="9,3" Margin="0,0,4,0"
                                FontSize="11" Cursor="Hand" />
                        <Button Content="反选" Click="OnInvertSelection"
                                Background="White" BorderBrush="{StaticResource BorderHoverBrush}"
                                BorderThickness="1" Padding="9,3" Margin="0,0,4,0"
                                FontSize="11" Cursor="Hand" />
                        <Button Content="清空" Click="OnClearSelection"
                                Background="White" BorderBrush="{StaticResource BorderHoverBrush}"
                                BorderThickness="1" Padding="9,3" Margin="0,0,12,0"
                                FontSize="11" Cursor="Hand" />
                        <Button x:Name="CombineSchemeButton" Content="✨ 组合为方案"
                                Background="{StaticResource PurpleAccentBrush}" Foreground="White"
                                BorderThickness="0"
                                Padding="12,3" Margin="0,0,4,0"
                                FontSize="11" Cursor="Hand"
                                IsEnabled="False"
                                Click="OnCombineSchemeClick"
                                ToolTip="请至少选择 2 个分镜（按勾选顺序生成方案）"
                                ToolTipService.ShowOnDisabled="True">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="r" Background="{TemplateBinding Background}"
                                            CornerRadius="4" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="r" Property="Background" Value="{StaticResource PurpleAccentDarkBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="r" Property="Opacity" Value="0.55"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button x:Name="BatchExportButton" Content="⬆ 批量导出"
                                Background="{StaticResource AccentBlueBrush}"
                                Foreground="White" BorderThickness="0"
                                Padding="12,3" Margin="0,0,4,0"
                                FontSize="11" Cursor="Hand"
                                Click="OnBatchExport" IsEnabled="False">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="r" Background="{TemplateBinding Background}"
                                            CornerRadius="4" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="r" Property="Background" Value="{StaticResource AccentBlueDarkBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="r" Property="Opacity" Value="0.55"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button x:Name="BatchDeleteButton" Content="🗑 批量删除"
                                Background="White"
                                BorderBrush="{StaticResource DangerRedBrush}"
                                Foreground="{StaticResource DangerRedBrush}"
                                BorderThickness="1" Padding="12,3"
                                FontSize="11" Cursor="Hand"
                                Click="OnBatchDelete" IsEnabled="False" />
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>

        <Border DockPanel.Dock="Top" Height="1"
                Background="{StaticResource BorderSubtleBrush}" Margin="0,4,0,8" />

        <!-- ========== 主体 ==========
             DockPanel：检视器 Dock=Right 先占 340px（隐藏时 0 宽），分镜区填剩余宽度。
             用 DockPanel 而非 Grid：确保右侧 drawer 占位后分镜区被约束在剩余宽度内换行，
             根治「WrapPanel 无限宽测量把右列挤出屏幕」的历史怪象。 -->
        <DockPanel LastChildFill="True">

            <!-- 配音变体检视器（v0.5.0）：单击分镜后右侧 drawer（浅色 UserControl，对齐 mac） -->
            <v:DubVariantInspectorView DockPanel.Dock="Right" VerticalAlignment="Stretch" Width="340" Margin="12,0,0,0"
                                       DataContext="{Binding DubInspector}"
                                       Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}" />

            <StackPanel x:Name="EmptyState" Visibility="Collapsed"
                        DockPanel.Dock="Top"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="🎬" FontSize="40"
                           Foreground="{StaticResource TextDisabledBrush}"
                           HorizontalAlignment="Center" />
                <TextBlock Text="没有符合条件的分镜" FontSize="13"
                           Foreground="{StaticResource TextTertiaryBrush}"
                           HorizontalAlignment="Center" Margin="0,8,0,4" />
            </StackPanel>

            <!-- 外层：按视频分组（对齐 Mac 版）。每组 = 视频 header + 该组分镜 WrapPanel（LastChildFill 填剩余） -->
            <ScrollViewer x:Name="GroupsScroller"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="GroupsHost" ItemsSource="{Binding Groups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type cards:VideoGroupViewModel}">
                            <StackPanel Margin="0,0,0,18">
                                <!-- 视频 header：缩略图 + 名称 + 分镜数 -->
                                <Border Margin="0,0,0,10" Padding="8,6"
                                        Background="{StaticResource BgSubtleBrush}"
                                        CornerRadius="8">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="40" Height="40" CornerRadius="6"
                                                ClipToBounds="True" Background="Black"
                                                Margin="0,0,10,0">
                                            <Image Source="{Binding ThumbnailImage}"
                                                   Stretch="UniformToFill" />
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding VideoName}"
                                                       FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       TextTrimming="CharacterEllipsis" MaxWidth="700" />
                                            <TextBlock Text="{Binding MetaText}"
                                                       FontSize="11"
                                                       Foreground="{StaticResource TextTertiaryBrush}"
                                                       Margin="0,2,0,0" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <!-- 配音设置条（v0.5.0，每视频独立）：状态区 + 变体数 stepper + 克隆并改写按钮。
                                     左对齐（分镜 WrapPanel 会把组撑宽，右对齐内容会被推出可见区外）。 -->
                                <Grid Margin="0,0,0,10" MinHeight="30" HorizontalAlignment="Left">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <!-- 主按钮 -->
                                        <Button Content="{Binding DubMainButtonText}" Command="{Binding RewriteAllCommand}"
                                                IsEnabled="{Binding IsNotDubBusy}" Cursor="Hand"
                                                Background="{StaticResource AccentBlueBrush}" Foreground="White"
                                                BorderThickness="0" Padding="12,6" FontSize="12" FontWeight="SemiBold"
                                                VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <!-- 变体数 stepper ×N -->
                                        <Border Background="{StaticResource BgSubtleBrush}" CornerRadius="6" Padding="2"
                                                Margin="0,0,10,0" VerticalAlignment="Center"
                                                IsEnabled="{Binding IsNotDubBusy}">
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="−" Style="{StaticResource FrameStepButtonStyle}"
                                                        ToolTip="减少变体数" Command="{Binding DecVariantCommand}" />
                                                <TextBlock VerticalAlignment="Center" MinWidth="28" TextAlignment="Center"
                                                           FontSize="11" FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextPrimaryBrush}">
                                                    <Run Text="×" /><Run Text="{Binding VariantCount, Mode=OneWay}" />
                                                </TextBlock>
                                                <Button Content="+" Style="{StaticResource FrameStepButtonStyle}"
                                                        ToolTip="增加变体数（每分镜产出几套改写版）" Command="{Binding IncVariantCommand}" />
                                            </StackPanel>
                                        </Border>
                                        <!-- 忙碌进度：阶段文案 + 进度条 + 百分比。
                                             可估算阶段（改写/合成）→ 百分比条 + 「N%」；
                                             不可估算阶段（分离人声/克隆）→ 无限滚动条（IsIndeterminate）传达「在动」。
                                             对齐 ImportView 的处理中进度样式（§商用丝滑标准 §1 进度反馈）。 -->
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                                    Visibility="{Binding IsDubBusy, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="{Binding DubProgress}" FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{StaticResource AccentBlueBrush}"
                                                       VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <ProgressBar Width="120" Height="5" VerticalAlignment="Center"
                                                         Minimum="0" Maximum="1"
                                                         Value="{Binding DubProgressValue, Mode=OneWay}"
                                                         IsIndeterminate="{Binding DubProgressIndeterminate}"
                                                         Foreground="{StaticResource AccentBlueBrush}"
                                                         Background="{StaticResource BgSubtleBrush}"
                                                         BorderThickness="0" />
                                            <TextBlock Text="{Binding DubPercentText}" FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       VerticalAlignment="Center" Margin="6,0,0,0" MinWidth="30" />
                                        </StackPanel>
                                        <!-- 空闲状态「✓ N 个变体」 -->
                                        <TextBlock Text="{Binding DubStatusText}" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{StaticResource SuccessGreenBrush}" VerticalAlignment="Center"
                                                   Visibility="{Binding IsDubBusy, Converter={StaticResource InverseBoolToVisibility}}" />
                                    </StackPanel>
                                </Grid>
                                <!-- 该组分镜卡片：WrapPanel 排列（每组小规模，不需要 VirtualizingWrapPanel） -->
                                <ItemsControl ItemsSource="{Binding Segments}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="Margin" Value="0,0,10,10" />
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type cards:SegmentCardViewModel}">
                        <Border x:Name="CardRoot"
                                Width="{StaticResource SegmentCardWidth}"
                                Height="{StaticResource SegmentCardHeight}"
                                Background="White"
                                BorderBrush="{StaticResource BorderPrimaryBrush}"
                                BorderThickness="1"
                                CornerRadius="10" Padding="8"
                                Cursor="Hand"
                                ClipToBounds="True"
                                Tag="{Binding}"
                                RenderTransformOrigin="0.5,0.5"
                                PreviewMouseLeftButtonDown="OnCardClicked"
                                MouseEnter="OnCardMouseEnter"
                                MouseLeave="OnCardMouseLeave">
                            <!-- P0-6：hover 时卡片 subtle 缩放浮起（纯 RenderTransform，不碰画刷，零冻结崩溃风险） -->
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1" />
                            </Border.RenderTransform>
                            <Border.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="📋 复制台词"
                                              Command="{Binding PlacementTarget.Tag.CopyTranscriptCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                    <MenuItem Header="📂 在 Explorer 中显示原视频"
                                              Command="{Binding PlacementTarget.Tag.ShowInExplorerCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                    <Separator />
                                    <MenuItem Header="🗑 删除分镜"
                                              Command="{Binding PlacementTarget.Tag.DeleteCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                </ContextMenu>
                            </Border.ContextMenu>

                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource AccentBlueAlpha10Brush}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource AccentBlueBrush}" />
                                            <Setter Property="BorderThickness" Value="1.5" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsChecked}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource AccentBlueAlpha20Brush}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource AccentBlueBrush}" />
                                            <Setter Property="BorderThickness" Value="2" />
                                        </DataTrigger>
                                        <!-- P0-6：hover 缩放浮起 120ms（EnterActions 放大 / ExitActions 复位） -->
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Trigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX"
                                                                         To="1.03" Duration="0:0:0.12" />
                                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY"
                                                                         To="1.03" Duration="0:0:0.12" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </Trigger.EnterActions>
                                            <Trigger.ExitActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX"
                                                                         To="1" Duration="0:0:0.12" />
                                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY"
                                                                         To="1" Duration="0:0:0.12" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </Trigger.ExitActions>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <!-- 对齐 mac：横向双栏 —— 左列(缩略图+标签+配音控件+边界) | 分隔线 | 右列台词（常显·大而可读·可编辑/重识别）。
                                 左列各控件默认落在 Column 0；台词跨全部行占 Column 2；边界靠弹性行推到底。 -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="210" />   <!-- 左列（缩略图宽） -->
                                    <ColumnDefinition Width="Auto" />  <!-- 分隔线 -->
                                    <ColumnDefinition Width="*" />     <!-- 右列：台词 -->
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />  <!-- 缩略图 -->
                                    <RowDefinition Height="Auto" />  <!-- 标签 -->
                                    <RowDefinition Height="Auto" />  <!-- 位置/质量 -->
                                    <RowDefinition Height="Auto" />  <!-- 字幕处理（P3） -->
                                    <RowDefinition Height="Auto" />  <!-- 边界微调 -->
                                    <RowDefinition Height="*" />     <!-- 弹性占位（底部）：吸收余量，台词跨全高 -->
                                </Grid.RowDefinitions>
                                <!-- 左右分隔线（跨全高） -->
                                <Rectangle Grid.Column="1" Grid.RowSpan="6" Width="1" Margin="8,4"
                                           Fill="{StaticResource BorderSubtleBrush}" />
                                <!-- 缩略图区 -->
                                <Border Grid.Row="0"
                                        Width="{StaticResource SegmentCardThumbWidth}"
                                        Height="{StaticResource SegmentCardThumbHeight}"
                                        Background="Black"
                                        CornerRadius="6" ClipToBounds="True">
                                    <Grid x:Name="ThumbGrid">
                                        <Image Source="{Binding PreviewImage}" Stretch="UniformToFill" />
                                        <!-- 注入的 InlineVideoPlayer 必须撑满 152x270 框：ContentControl 默认内容对齐 Left/Top
                                             会让 player 缩到内容尺寸（hover 播放不铺满的结构性根因），显式 Stretch 撑满。 -->
                                        <ContentControl x:Name="VideoHost"
                                                        HorizontalContentAlignment="Stretch"
                                                        VerticalContentAlignment="Stretch" />

                                        <!-- 编号徽章（左上） -->
                                        <Border Background="#C01D6BE5" CornerRadius="4"
                                                Padding="5,1"
                                                HorizontalAlignment="Left" VerticalAlignment="Top"
                                                Margin="6,6,0,0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SequenceNumber}" Value="0">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Foreground="White" FontSize="10" FontWeight="Bold"
                                                       FontFamily="{StaticResource FontFamilyMono}">
                                                <Run Text="#" /><Run Text="{Binding SequenceNumber, Mode=OneWay}" />
                                            </TextBlock>
                                        </Border>

                                        <!-- 时长 badge（右下，走 binding 自动联动）。hover 播放时隐藏，
                                             避免挡住播放控制栏右侧的总时长数字（OnCardMouseEnter/Leave 切换）。 -->
                                        <Border x:Name="CardDurationBadge"
                                                Background="#A0000000" CornerRadius="4"
                                                Padding="6,1"
                                                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                Margin="0,0,6,6"
                                                ToolTip="{Binding TimeRangeDisplay}">
                                            <TextBlock Text="{Binding DurationDisplay}"
                                                       Foreground="White" FontSize="10"
                                                       FontWeight="SemiBold" />
                                        </Border>

                                        <!-- 多选标记（右上） -->
                                        <Border Width="24" Height="24"
                                                BorderBrush="#C01D6BE5" BorderThickness="2"
                                                CornerRadius="999"
                                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                                Margin="0,6,6,0"
                                                Visibility="{Binding IsSelectionMode, Converter={StaticResource BoolToVisibility}}">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#A0FFFFFF" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsChecked}" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource AccentBlueBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="✓" Foreground="White"
                                                       FontSize="14" FontWeight="Bold"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Visibility="{Binding IsChecked, Converter={StaticResource BoolToVisibility}}" />
                                        </Border>

                                        <!-- hover 自动播放（对齐 mac）：进卡 0.35s 起播，离卡停。▶ 仅作静态提示，
                                             不接收点击（IsHitTestVisible=False），让点击落到卡片 → 选中弹变体池。
                                             播放时由 StartHoverPlay 隐藏、播完/停止由 Idle 还原。多选模式隐藏。
                                             x:Name=PlayOverlay 供后台代码定位显隐。 -->
                                        <Grid x:Name="PlayOverlay" IsHitTestVisible="False"
                                              Visibility="{Binding IsSelectionMode, Converter={StaticResource InverseBoolToVisibility}}">
                                            <Border Background="#90000000" CornerRadius="999" Width="46" Height="46"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="▶" Foreground="White" FontSize="16"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Margin="3,0,0,0" />
                                            </Border>
                                        </Grid>

                                        <!-- P3：字幕遮挡框 + 字号预览（叠在缩略图上）。未保留原声即显示（三种字幕处理都要预览字号）；
                                             遮挡蓝框仅「模糊虚化 / 纯色遮挡」时由 ShowMaskBox 显示。 -->
                                        <sl:SubtitleMaskOverlay Rect="{Binding MaskRect, Mode=TwoWay}"
                                                                CommitCommand="{Binding CommitMaskCommand}"
                                                                ShowMaskBox="{Binding NeedsMaskEditor}"
                                                                Visibility="{Binding SubtitlePreviewVisible, Converter={StaticResource BoolToVisibility}}" />
                                    </Grid>
                                </Border>

                                <!-- 标签 + 位置 + 质量分 -->
                                <ItemsControl Grid.Row="1" ItemsSource="{Binding SemanticTypes}" Margin="0,6,0,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="999" Padding="7,2" Margin="0,0,4,4"
                                                    Background="{Binding ., Converter={StaticResource SemanticTypeToTintBrush}}">
                                                <TextBlock Text="{Binding ., Converter={StaticResource SemanticTypeToLabel}}"
                                                           FontSize="10" FontWeight="SemiBold"
                                                           Foreground="{Binding ., Converter={StaticResource SemanticTypeToBrush}}" />
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <WrapPanel Grid.Row="2">
                                    <Border CornerRadius="999" Padding="7,2" Margin="0,0,4,4"
                                            Background="#15888888">
                                        <TextBlock Text="{Binding PositionType, Converter={StaticResource PositionTypeToLabel}}"
                                                   FontSize="10" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextTertiaryBrush}" />
                                    </Border>
                                    <Border CornerRadius="999" Padding="7,2" Margin="0,0,4,4"
                                            Background="#152E8B57">
                                        <TextBlock FontSize="10" FontWeight="SemiBold"
                                                   Foreground="{Binding QualityScore, Converter={StaticResource QualityScoreToBrush}}">
                                            <Run Text="★ " /><Run Text="{Binding QualityScore, Mode=OneWay, StringFormat={}{0:F1}}" />
                                        </TextBlock>
                                    </Border>
                                </WrapPanel>

                                <!-- 字幕处理（P3）：保留原声 + 三胶囊 + 遮挡区应用 -->
                                <StackPanel Grid.Row="3" Margin="0,6,0,0">
                                    <!-- 保留原声开关 -->
                                    <CheckBox IsChecked="{Binding IsVoiceLocked, Mode=OneWay}" Command="{Binding ToggleVoiceLockCommand}"
                                              Cursor="Hand" Content="🔒 保留原声"
                                              FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" />

                                    <!-- 字幕处理（未锁定才显示） -->
                                    <StackPanel Margin="0,4,0,0"
                                                Visibility="{Binding IsVoiceLocked, Converter={StaticResource InverseBoolToVisibility}}">
                                        <TextBlock Text="字幕处理" FontSize="9" FontWeight="Medium"
                                                   Foreground="{StaticResource TextTertiaryBrush}" Margin="0,0,0,3" />
                                        <WrapPanel>
                                            <Button Content="直接烧录" Command="{Binding SetTreatmentCommand}" CommandParameter="Direct"
                                                    ToolTip="不处理背景，直接把新字幕烧上去"
                                                    Padding="7,3" FontSize="10" Margin="0,0,4,4" Cursor="Hand"
                                                    BorderThickness="0">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <!-- 默认色必须放 Style Setter，不能写成 Button 本地属性：本地值优先级高于 Style 触发器，
                                                             一旦写在 Button 上，下面选中态 DataTrigger 的 Background/Foreground 会被永久覆盖→胶囊永不高亮。 -->
                                                        <Setter Property="Background" Value="{StaticResource BgQuaternaryBrush}" />
                                                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border Background="{TemplateBinding Background}" CornerRadius="999"
                                                                            Padding="{TemplateBinding Padding}">
                                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                    </Border>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SubtitleTreatment}" Value="Direct">
                                                                <Setter Property="Background" Value="{StaticResource AccentBlueBrush}" />
                                                                <Setter Property="Foreground" Value="White" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                            <Button Content="模糊虚化" Command="{Binding SetTreatmentCommand}" CommandParameter="Blur"
                                                    ToolTip="把字幕区域糊掉再烧（不管有没有旧字幕都可用）"
                                                    Padding="7,3" FontSize="10" Margin="0,0,4,4" Cursor="Hand"
                                                    BorderThickness="0">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Background" Value="{StaticResource BgQuaternaryBrush}" />
                                                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border Background="{TemplateBinding Background}" CornerRadius="999"
                                                                            Padding="{TemplateBinding Padding}">
                                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                    </Border>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SubtitleTreatment}" Value="Blur">
                                                                <Setter Property="Background" Value="{StaticResource AccentBlueBrush}" />
                                                                <Setter Property="Foreground" Value="White" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                            <Button Content="纯色遮挡" Command="{Binding SetTreatmentCommand}" CommandParameter="Solid"
                                                    ToolTip="深色条盖住该区域再烧"
                                                    Padding="7,3" FontSize="10" Margin="0,0,4,4" Cursor="Hand"
                                                    BorderThickness="0">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Background" Value="{StaticResource BgQuaternaryBrush}" />
                                                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border Background="{TemplateBinding Background}" CornerRadius="999"
                                                                            Padding="{TemplateBinding Padding}">
                                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                    </Border>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SubtitleTreatment}" Value="Solid">
                                                                <Setter Property="Background" Value="{StaticResource AccentBlueBrush}" />
                                                                <Setter Property="Foreground" Value="White" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </WrapPanel>
                                        <!-- 遮挡区应用到所有分镜（模糊/纯色才显示） -->
                                        <Button Content="⊞ 遮挡区应用到所有分镜" Command="{Binding ApplyMaskToAllCommand}"
                                                Visibility="{Binding NeedsMaskEditor, Converter={StaticResource BoolToVisibility}}"
                                                HorizontalAlignment="Left" Margin="0,4,0,0" Padding="0" FontSize="10"
                                                Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                Foreground="{StaticResource AccentBlueBrush}"
                                                ToolTip="把本分镜的字幕处理方式与遮挡框复制到同一视频的其它分镜" />

                                        <!-- 字幕字号（全局统一）：拖动时上方画面里的示例字幕实时变大变小，可与原字幕比大小。
                                             绑定全局共享 SubtitleFontState（所有卡片 + 导出烧录共用一份），对齐 mac 字号滑条。 -->
                                        <StackPanel Margin="0,8,0,0">
                                            <DockPanel LastChildFill="False" Margin="0,0,0,2">
                                                <TextBlock DockPanel.Dock="Left" Text="字幕字号" FontSize="9" FontWeight="Medium"
                                                           Foreground="{StaticResource TextTertiaryBrush}" />
                                                <TextBlock DockPanel.Dock="Right" FontSize="9"
                                                           Foreground="{StaticResource TextTertiaryBrush}"
                                                           Text="{Binding PercentText, Source={x:Static vm:SubtitleFontState.Shared}}" />
                                            </DockPanel>
                                            <!-- Min/Max = SubtitleFontSize.MinRatio/MaxRatio (0.030~0.085) -->
                                            <Slider Minimum="0.030" Maximum="0.085" SmallChange="0.002" LargeChange="0.005"
                                                    Value="{Binding Ratio, Source={x:Static vm:SubtitleFontState.Shared}, Mode=TwoWay}"
                                                    ToolTip="字幕字号全片统一。拖动时上方画面里的示例字幕会实时变化，可与原视频字幕对比大小。" />
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>

                                <!-- 台词块（右列，跨全高常显；对齐 mac：大而可读，hover 显 ✏ 编辑 / ↻ 重识别） -->
                                <Border Grid.Column="2" Grid.RowSpan="6"
                                        Background="{StaticResource BgSubtleBrush}"
                                        BorderBrush="{StaticResource BorderSubtleBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6" Padding="10,8" Margin="0">
                                    <Border.Resources>
                                        <!-- 台词区图标按钮统一样式（✏ ↻ ✓ ✕）：透明底、圆角、hover 高亮 -->
                                        <Style x:Key="TranscriptIconBtn" TargetType="Button">
                                            <Setter Property="Width" Value="18" />
                                            <Setter Property="Height" Value="18" />
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="Margin" Value="4,0,0,0" />
                                            <Setter Property="FontSize" Value="10" />
                                            <Setter Property="Cursor" Value="Hand" />
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="Foreground" Value="{StaticResource AccentBlueBrush}" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource AccentBlueLightBrush}" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Resources>
                                    <!-- 标题行常显（含 ✏/↻ 操作），下方 body 三态：编辑 / 有词 / 无词 -->
                                    <DockPanel>
                                        <Grid DockPanel.Dock="Top" Margin="0,0,0,3">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="💬" FontSize="9"
                                                           VerticalAlignment="Center" Margin="0,0,4,0" />
                                                <TextBlock Text="台词" FontSize="10" FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextTertiaryBrush}"
                                                           VerticalAlignment="Center" />
                                                <TextBlock FontSize="9"
                                                           FontFamily="{StaticResource FontFamilyMono}"
                                                           Foreground="{StaticResource TextQuaternaryBrush}"
                                                           VerticalAlignment="Center" Margin="2,0,0,0">
                                                    <Run Text=" · " /><Run Text="{Binding TranscriptCharCount, Mode=OneWay}" /><Run Text="字" />
                                                </TextBlock>
                                            </StackPanel>
                                            <!-- 非编辑态：✏ 编辑 + ↻ 重识别（hover/选中显示；空台词也显示，可直接输入/重识别） -->
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                        Visibility="{Binding TranscriptActionsVisible, Converter={StaticResource BoolToVisibility}}">
                                                <Button Content="✏" Command="{Binding BeginEditTextCommand}"
                                                        Style="{StaticResource TranscriptIconBtn}" ToolTip="编辑台词" />
                                                <Button Content="↻" Command="{Binding ReRecognizeCommand}"
                                                        Style="{StaticResource TranscriptIconBtn}"
                                                        ToolTip="用阿里云 ASR 重新识别该分镜台词（替换原台词）" />
                                            </StackPanel>
                                            <!-- 编辑态：✓ 保存 + ✕ 取消 -->
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                        Visibility="{Binding IsEditingText, Converter={StaticResource BoolToVisibility}}">
                                                <Button Content="✓" Command="{Binding SaveTextCommand}"
                                                        Style="{StaticResource TranscriptIconBtn}"
                                                        Foreground="{StaticResource SuccessGreenBrush}" ToolTip="保存（Ctrl+Enter）" />
                                                <Button Content="✕" Command="{Binding CancelEditTextCommand}"
                                                        Style="{StaticResource TranscriptIconBtn}"
                                                        Foreground="{StaticResource TextTertiaryBrush}" ToolTip="取消（Esc）" />
                                            </StackPanel>
                                        </Grid>
                                        <Grid>
                                            <!-- 编辑态：TextBox（双向绑 DraftText，Ctrl+Enter 保存 / Esc 取消） -->
                                            <TextBox Visibility="{Binding IsEditingText, Converter={StaticResource BoolToVisibility}}"
                                                     Text="{Binding DraftText, UpdateSourceTrigger=PropertyChanged}"
                                                     AcceptsReturn="True" TextWrapping="Wrap"
                                                     VerticalScrollBarVisibility="Auto"
                                                     MinHeight="48" MaxHeight="160"
                                                     FontSize="11"
                                                     IsVisibleChanged="TranscriptEditBox_IsVisibleChanged"
                                                     Background="{StaticResource BgPrimaryBrush}"
                                                     Foreground="{StaticResource TextPrimaryBrush}"
                                                     BorderBrush="{StaticResource AccentBlueBrush}" BorderThickness="1"
                                                     Padding="5,3">
                                                <TextBox.InputBindings>
                                                    <KeyBinding Modifiers="Control" Key="Return" Command="{Binding SaveTextCommand}" />
                                                    <KeyBinding Key="Escape" Command="{Binding CancelEditTextCommand}" />
                                                </TextBox.InputBindings>
                                            </TextBox>
                                            <!-- 有台词只读态 -->
                                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                          HorizontalScrollBarVisibility="Disabled"
                                                          Visibility="{Binding TranscriptReadonlyVisible, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="{Binding TranscriptText}"
                                                           FontSize="12.5" TextWrapping="Wrap"
                                                           LineHeight="20"
                                                           Foreground="{StaticResource TextPrimaryBrush}" />
                                            </ScrollViewer>
                                            <!-- 无台词占位 -->
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        Visibility="{Binding TranscriptEmptyVisible, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="🔇" FontSize="11"
                                                           Foreground="{StaticResource TextQuinaryBrush}"
                                                           Margin="0,0,4,0" />
                                                <TextBlock Text="暂无台词，点 ✏ 手写或 ↻ 重识别" FontSize="10"
                                                           Foreground="{StaticResource TextQuaternaryBrush}"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Grid>
                                    </DockPanel>
                                </Border>

                                <!-- 商用级帧边界面板：时间码清楚、按钮可点、最后一帧可核对。 -->
                                <Border Grid.Row="4" Margin="0,8,0,0" Padding="8"
                                        Background="{StaticResource BgSubtleBrush}"
                                        BorderBrush="{StaticResource BorderSubtleBrush}"
                                        BorderThickness="1" CornerRadius="8">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,6">
                                            <TextBlock Text="帧边界" FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimaryBrush}" />
                                            <TextBlock HorizontalAlignment="Right"
                                                       Text="{Binding FrameRateDisplay}"
                                                       FontSize="9"
                                                       Foreground="{StaticResource TextQuaternaryBrush}" />
                                        </Grid>

                                        <Grid Margin="0,0,0,5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="28" />
                                                <ColumnDefinition Width="28" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="28" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="IN" FontSize="9" FontWeight="Bold"
                                                       Foreground="{StaticResource AccentBlueBrush}"
                                                       VerticalAlignment="Center" />
                                            <Button Grid.Column="1" Content="−"
                                                    Style="{StaticResource FrameStepButtonStyle}"
                                                    ToolTip="起点向前一帧"
                                                    Command="{Binding AdjustStartCommand}"
                                                    CommandParameter="-1" />
                                            <Border Grid.Column="2" Height="28" Margin="5,0"
                                                    Background="White"
                                                    BorderBrush="{StaticResource BorderPrimaryBrush}"
                                                    BorderThickness="1" CornerRadius="6">
                                                <TextBlock Text="{Binding StartTimecode}"
                                                           FontFamily="{StaticResource FontFamilyMono}"
                                                           FontSize="10" FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextPrimaryBrush}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                            </Border>
                                            <Button Grid.Column="3" Content="+"
                                                    Style="{StaticResource FrameStepButtonStyle}"
                                                    ToolTip="起点向后一帧"
                                                    Command="{Binding AdjustStartCommand}"
                                                    CommandParameter="1" />
                                        </Grid>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="28" />
                                                <ColumnDefinition Width="28" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="28" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="OUT" FontSize="9" FontWeight="Bold"
                                                       Foreground="{StaticResource AccentBlueBrush}"
                                                       VerticalAlignment="Center" />
                                            <Button Grid.Column="1" Content="−"
                                                    Style="{StaticResource FrameStepButtonStyle}"
                                                    ToolTip="终点向前一帧"
                                                    Command="{Binding AdjustEndCommand}"
                                                    CommandParameter="-1" />
                                            <Border Grid.Column="2" Height="28" Margin="5,0"
                                                    Background="White"
                                                    BorderBrush="{StaticResource BorderPrimaryBrush}"
                                                    BorderThickness="1" CornerRadius="6">
                                                <TextBlock Text="{Binding EndTimecode}"
                                                           FontFamily="{StaticResource FontFamilyMono}"
                                                           FontSize="10" FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextPrimaryBrush}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           ToolTip="结束边界不包含；实际最后画面见下方" />
                                            </Border>
                                            <Button Grid.Column="3" Content="+"
                                                    Style="{StaticResource FrameStepButtonStyle}"
                                                    ToolTip="终点向后一帧"
                                                    Command="{Binding AdjustEndCommand}"
                                                    CommandParameter="1" />
                                        </Grid>

                                        <Grid Margin="0,7,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock FontSize="9"
                                                       Foreground="{StaticResource TextTertiaryBrush}">
                                                <Run Text="停在最后一帧  " />
                                                <Run Text="{Binding LastFrameTimecode, Mode=OneWay}"
                                                     FontFamily="{StaticResource FontFamilyMono}"
                                                     FontWeight="SemiBold" />
                                            </TextBlock>
                                            <Button x:Name="QuickEditBtn" Grid.Column="1"
                                                    HorizontalAlignment="Right"
                                                    Content="更多"
                                                    Style="{StaticResource GhostButtonStyle}"
                                                    Padding="6,1" FontSize="9"
                                                    Tag="{Binding}"
                                                    Click="OnQuickEditClick" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

        </DockPanel>
    </DockPanel>
</UserControl>
